# LLM 配置：默认走本机 Ollama 的 OpenAI 兼容接口
# 如果有 Anthropic / 其他 OpenAI 兼容服务，改这三项即可
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=deepseek-v4.1-flash:cloud

# 数据库路径（相对项目根目录）
DEAL_RADAR_DB=data/deal_radar.db

# 你的技能画像，打分时会作为上下文
SKILL_PROFILE=AI 应用开发、Python、大模型应用（RAG/Agent）、BIM/CAD 行业工具定制
